# Federated production path: Auto-Company -> SynergyNet opaque relay -> SHTTPS service.
# No plaintext HTTP fallback.
SYNERGY_COMPANY_MODE=paper
SYNERGY_AUTOPILOT_ENABLED=1
SYNERGY_AUTOPILOT_SHTTPS_HOST=127.0.0.1
SYNERGY_AUTOPILOT_SHTTPS_PORT=9120
SYNERGY_AUTOPILOT_SHTTPS_EXPECTED_PEER=<AUTOPILOT_NODE_ID>
SYNERGY_NEXUS_ENABLED=1
SYNERGY_NEXUS_SHTTPS_HOST=127.0.0.1
SYNERGY_NEXUS_SHTTPS_PORT=9130
SYNERGY_NEXUS_SHTTPS_EXPECTED_PEER=<NEXUS_NODE_ID>
SYNERGY_COMPANY_SHTTPS_IDENTITY=/run/secrets/synergy-company-shttps-identity.json
SYNERGY_COMPANY_SHTTPS_TRUST=/run/secrets/synergy-company-shttps-trust.json
SYNERGY_COMPANY_SHTTPS_REQUIRE_AI_COMPRESS=1
SYNERGY_COMPANY_SHTTPS_MAX_IDENTITY=0
SHTTPS_AI_COMPRESS_PATH=/opt/synergy/ai_compress
SYNERGY_SHTTPS_TIMEOUT=15
SYNERGY_ENABLE_AUTOPILOT_SCOUT=0
SYNERGY_MAX_EXTERNAL_SPEND_USD=0
SYNERGY_MAX_FINANCIAL_ACTION_USD=0
SYNERGY_MAX_DAILY_LOSS_USD=0

# Expected SynergyNet relay mapping:
# 127.0.0.1:9120 -> 127.0.0.1:8120 (autopilot-shttps)
# 127.0.0.1:9130 -> 127.0.0.1:8130 (nexus-shttps)
