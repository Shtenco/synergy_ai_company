# Federated production path: Auto-Company -> SynergyNet opaque relay -> SHTTPS service.
# No plaintext HTTP fallback and no manually maintained peer trust file.
SYNERGY_COMPANY_MODE=paper
SYNERGY_AUTOPILOT_ENABLED=1
SYNERGY_AUTOPILOT_SHTTPS_HOST=127.0.0.1
SYNERGY_AUTOPILOT_SHTTPS_PORT=9120
SYNERGY_NEXUS_ENABLED=1
SYNERGY_NEXUS_SHTTPS_HOST=127.0.0.1
SYNERGY_NEXUS_SHTTPS_PORT=9130

# Auto-Company is a separate signed control-plane principal in the federation registry.
SYNERGY_COMPANY_SHTTPS_REPOSITORY=synergy_ai_company
SYNERGY_COMPANY_SHTTPS_IDENTITY=/run/secrets/synergy_ai_company.identity.json
SYNERGY_COMPANY_SHTTPS_FEDERATION_ROOT=/etc/synergy/federation/federation-root.json
SYNERGY_COMPANY_SHTTPS_FEDERATION_REGISTRY=/etc/synergy/federation/federation-registry.signed.json
SYNERGY_COMPANY_SHTTPS_FEDERATION_SIGNER_REVOCATIONS=/etc/synergy/federation/registry-signer.revocations.json
SYNERGY_COMPANY_SHTTPS_FEDERATION_STATE=/var/lib/synergy/company-federation-state.json
SYNERGY_COMPANY_SHTTPS_REQUIRE_AI_COMPRESS=1
SYNERGY_COMPANY_SHTTPS_MAX_IDENTITY=0
SHTTPS_AI_COMPRESS_PATH=/opt/synergy/ai_compress
SYNERGY_SHTTPS_TIMEOUT=15

# Expected remote identities are resolved automatically as the active/retiring
# nodes for agi_autopilot and agi_nexus in the verified signed registry.
# Root-signed Registry Signer revocation state is mandatory for delegated registries.
# Optional *_EXPECTED_PEER values are legacy extra pins only.

SYNERGY_ENABLE_AUTOPILOT_SCOUT=0
SYNERGY_MAX_EXTERNAL_SPEND_USD=0
SYNERGY_MAX_FINANCIAL_ACTION_USD=0
SYNERGY_MAX_DAILY_LOSS_USD=0

# Expected SynergyNet relay mapping:
# 127.0.0.1:9120 -> 127.0.0.1:8120 (autopilot-shttps)
# 127.0.0.1:9130 -> 127.0.0.1:8130 (nexus-shttps)
