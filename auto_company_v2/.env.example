# Core
SYNERGY_COMPANY_DB=var/synergy_company.db
SYNERGY_COMPANY_MODE=paper
SYNERGY_COMPANY_PAUSED=0
SYNERGY_AI_DAILY_BUDGET_USD=10
SYNERGY_MAX_EXTERNAL_SPEND_USD=0
SYNERGY_MAX_FINANCIAL_ACTION_USD=0
SYNERGY_MAX_DAILY_LOSS_USD=0

# AI Autopilot runtime. Set ENABLED=1 when feat/capability-runtime-v1 (or its merged successor) is running.
SYNERGY_AUTOPILOT_ENABLED=0
SYNERGY_AUTOPILOT_URL=http://127.0.0.1:8120
SYNERGY_AUTOPILOT_TASK_PATH=/v1/tasks
SYNERGY_AUTOPILOT_STATUS_PATH=/v1/tasks/{task_id}
SYNERGY_AUTOPILOT_EXECUTE_PATH=/v1/tasks/{task_id}/execute
SYNERGY_AUTOPILOT_APPROVE_PATH=/v1/tasks/{task_id}/approve
SYNERGY_AUTOPILOT_TOKEN=
SYNERGY_ENABLE_AUTOPILOT_SCOUT=0

# NEXUS HTTP sidecar. Set ENABLED=1 when feat/http-sidecar-memory-v1 (or its merged successor) is running.
SYNERGY_NEXUS_ENABLED=0
SYNERGY_NEXUS_URL=http://127.0.0.1:8130
SYNERGY_NEXUS_SEARCH_PATH=/v1/memory/search
SYNERGY_NEXUS_UPSERT_PATH=/v1/memory/upsert
SYNERGY_NEXUS_TOKEN=

# GitHub opportunity discovery
GITHUB_TOKEN=
GITHUB_SEARCH_QUERY=is:issue is:open label:"help wanted" no:assignee

# Telegram control plane
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_SECONDS=2

# Optional API auth for the local control plane. If empty, bind to localhost only.
SYNERGY_API_TOKEN=
SYNERGY_BIND_HOST=127.0.0.1
SYNERGY_BIND_PORT=8788

SYNERGY_DISCOVERY_INTERVAL_SECONDS=900
SYNERGY_MIN_VALIDATION_SCORE=20
